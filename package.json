{
  "name": "neural-blueprint",
  "private": true,
  "version": "0.0.0",
  "description": "Neural BluePrint desktop app",
  "author": "Neural BluePrint",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "icons:build": "node scripts/generate-neural-blueprint-icon.cjs",
    "electron": "npm run build && electron .",
    "app:pack": "npm run icons:build && npm run build && electron-builder --dir",
    "app:dist": "npm run icons:build && npm run build && electron-builder"
  },
  "build": {
    "appId": "com.neuralblueprint.app",
    "productName": "Neural BluePrint",
    "icon": "assets/icons/neural-blueprint.ico",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "assets/icons/neural-blueprint.ico",
      "target": "nsis"
    },
    "fileAssociations": [
      {
        "ext": "nbp",
        "name": "Neural Blueprint File",
        "description": "Neural BluePrint project",
        "icon": "assets/icons/neural-blueprint.ico",
        "role": "Editor"
      }
    ]
  },
  "dependencies": {
    "@xyflow/react": "^12.11.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
